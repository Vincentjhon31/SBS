{
  "categories": [
    { "title": "## ✨ New Features", "labels": ["feat"] },
    { "title": "## 🚀 Improvements", "labels": ["perf", "improvement"] },
    { "title": "## 🧩 Fixes", "labels": ["fix"] },
    { "title": "## ⚙️ Changes", "labels": ["chore", "refactor", "docs"] }
  ],
  "label_extractor": [
    { "pattern": "^feat(\\(.+\\))?:", "target": "feat" },
    { "pattern": "^fix(\\(.+\\))?:", "target": "fix" },
    { "pattern": "^perf(\\(.+\\))?:", "target": "perf" },
    { "pattern": "^(chore|refactor|docs)(\\(.+\\))?:", "target": "chore" }
  ],
  "template": "#{{CHANGELOG}}",
  "pr_template": "- #{{TITLE}} (#{{MERGE_SHA}})",
  "empty_template": "No notable changes.",
  "max_tags_to_fetch": 20,
  "max_pull_requests": 200,
  "max_back_track_time_days": 365
}
